# Copy to .env.local and fill in from Supabase → Project Settings → API.
# These stay on the server; they are never bundled into the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional. With a secret key the app bypasses RLS, so you can drop the
# permissive anon policies in supabase/migrations and lock the tables down.
# SUPABASE_SECRET_KEY=sb_secret_...

# Only needed to run `npm run db:push` (applies supabase/migrations).
# Supabase → Project Settings → Database → Connection string → URI.
# SUPABASE_DB_URL=postgresql://postgres:YOUR-PASSWORD@db.<project-ref>.supabase.co:5432/postgres
